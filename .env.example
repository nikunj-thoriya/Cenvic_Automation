# Template for .env.dev and .env.demo. Never put real credentials in this file.
# Select the environment at run time with TEST_ENV=dev or TEST_ENV=demo (defaults to dev).

# Application
BASE_URL=
LOGIN_PATH=/login
API_BASE_URL=
# API documentation (reference only; not read by the framework)
SWAGGER_URL=
SWAGGER_JSON_URL=
# Browser and execution settings
HEADLESS=true
RETRIES=0
WORKERS=2
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# Role credentials: <ROLE>_USERNAME / <ROLE>_PASSWORD (roles to be confirmed)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Account with no campaigns (TC-DASHBOARD-033 is skipped while these are empty)
NO_CAMPAIGN_USER_USERNAME=
NO_CAMPAIGN_USER_PASSWORD=

# Dedicated Forgot/Reset Password account (username must be a YOPmail address of a registered user)
RESET_USER_USERNAME=
RESET_USER_PASSWORD=
RESET_USER_NEW_PASSWORD=
YOPMAIL_URL=https://yopmail.com
